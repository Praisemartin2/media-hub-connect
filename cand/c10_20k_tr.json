  },
  {
   "start": 12.8,
   "end": 15.12,
   "text": "Pretty smooth, I like that, I like that."
  },
  {
   "start": 15.5,
   "end": 16.36,
   "text": "That's awesome, man,"
  },
  {
   "start": 16.42,
   "end": 20.24,
