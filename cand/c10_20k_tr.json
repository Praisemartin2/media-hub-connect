   "start": 0.0,
   "end": 2.94,
   "text": "On the low months, somewhere around 10, 11K,"
  },
  {
   "start": 3.32,
   "end": 5.06,
   "text": "on the higher months, like summer months"
  },
  {
   "start": 5.06,
   "end": 6.86,
   "text": "where you start to get like the World Cup"
